{
  "name": "bookly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "firebase": "npx --yes firebase-tools@latest",
    "rules": "node scripts/build-rules.mjs",
    "deploy": "node scripts/build-rules.mjs && vite build && npx --yes firebase-tools@latest deploy --only hosting,firestore:rules",
