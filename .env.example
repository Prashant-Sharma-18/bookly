# Copy this file to .env and fill in the values. .env is git-ignored.
# Restart `npm run dev` after editing.

# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration (Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional spam protection (Firebase App Check with reCAPTCHA v3). See README > Spam protection.
VITE_RECAPTCHA_SITE_KEY=
# Optional: a fixed App Check debug token for local dev (otherwise a new one is printed in the browser console).
VITE_APPCHECK_DEBUG_TOKEN=

# The host's Google account. Signs in at /#admin and receives "new request" emails.
# Also written into the deployed Firestore rules by `npm run rules` / `npm run deploy`.
VITE_ADMIN_EMAIL=

# EmailJS dashboard: Email Services (service ID), Email Templates (template ID), Account > General (public key)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
